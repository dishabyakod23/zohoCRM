# Sales CRM API (default: production)
NEXT_PUBLIC_API_URL=https://salescrm-api.duckdns.org/api/v1

# Set automatically during production static export (deploy.sh)
# NEXT_PUBLIC_STATIC_EXPORT=true
# NEXT_PUBLIC_CLOUDTALK_ENABLED=true
# NEXT_PUBLIC_CLOUDTALK_PARTNER=sale-crm

# Backend only (salescrm-api) — required for full CloudTalk call history in audit logs:
# CLOUDTALK_KEY_ID=your_access_key_id
# CLOUDTALK_API_SECRET=your_access_key_secret
# CLOUDTALK_API_BASE=https://my.cloudtalk.io/api

# Backend only (salescrm-api) — Resend for sequence email + tracking:
# RESEND_API_KEY=re_xxxx
# RESEND_WEBHOOK_SECRET=whsec_xxxx
# SEQUENCE_EMAIL_PROVIDER=resend
# See docs/RESEND_SETUP.md for domain verification, webhooks, and API contract.
